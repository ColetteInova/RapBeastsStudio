rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /custom_songs/{allPaths=**} {
      // Leitura pública: o jogo baixa o zip via ?alt=media sem token.
      allow read: if true;
      // Escrita: qualquer usuário autenticado (provisório — troque pelo
      // UID do autor após o primeiro login, ver firestore.rules).
      allow write: if request.auth != null;
    }
  }
}
